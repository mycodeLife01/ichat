POSTGRES_USER=ichat
POSTGRES_PASSWORD=ichat_password
POSTGRES_DB=ichat
POSTGRES_PORT=5432
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://ichat:ichat_password@postgres:5432/ichat
JWT_SECRET=change-me-local-dev-only
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

DEEPSEEK_API_KEY=replace-in-real-deployments
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Comma-separated list of DeepSeek chat models users may pick. "-pro" models
# expose only the high/max thinking levels; others also offer the low tier.
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# Server-side defaults for thinking mode; each send/regenerate request may
# override them via thinking_enabled / reasoning_effort in the request body.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high

# OpenAI-compatible provider (optional). Leave the API key empty to hide these
# models from the selector. OPENAI_MODELS is a comma-separated list of chat
# models users may pick. Works with aggregators like OpenRouter too — set
# OPENAI_BASE_URL=https://openrouter.ai/api/v1 and use their model ids
# (e.g. openai/gpt-5.6-luna); vendor prefixes are handled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-5-mini

# Optional override for the assistant's base system prompt. Leave empty to use
# the bundled production prompt in app/prompts/base_system_prompt.md; set a value
# here only to override it without a code change.
DEFAULT_SYSTEM_PROMPT=
# Token budget for the prompt context (system prompt + history). Estimated with
# the provider's count_tokens heuristic; keep well below the model window and
# size it for cost/latency, not the window limit.
CONTEXT_BUDGET_TOKENS=256000
ATTACHMENT_TARGET_TURN_TOKENS=128000
RUN_LEASE_SECONDS=60
# Fallback poll interval. Redis pub/sub normally wakes the worker immediately;
# this PostgreSQL poll is the safety net for lost/unavailable wakeup hints.
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_MAX_INFLIGHT_RUNS=8
# Per-run Redis Stream bounds. The orphan TTL is set on first write; terminal
# events shorten it to RUN_STREAM_TTL_SECONDS.
RUN_STREAM_MAXLEN=2048
RUN_STREAM_TTL_SECONDS=600
RUN_STREAM_ORPHAN_TTL_SECONDS=86400
# PostgreSQL fallback checkpoints: write after the time window or pending-char
# ceiling, whichever comes first. Tool boundaries force a checkpoint.
DRAFT_CHECKPOINT_INTERVAL_SECONDS=3.0
DRAFT_CHECKPOINT_MAX_PENDING_CHARS=4096
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
AUTO_TITLE_ENABLED=true
SUMMARY_PROVIDER_NAME=deepseek
SUMMARY_MODEL=deepseek-chat
AUTO_TITLE_MAX_CHARS=32
AUTO_TITLE_MAX_OUTPUT_TOKENS=40
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Web search tool (Tavily). Disabled by default; frontend reads
# GET /api/v1/capabilities and only sends web_search_enabled=true when this is
# enabled and a Tavily key is configured.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_TOOL_CALLS=2
WEB_SEARCH_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_EXTRACT_TIMEOUT_SECONDS=8
WEB_SEARCH_TOTAL_TIMEOUT_SECONDS=25
WEB_SEARCH_DEFAULT_MAX_RESULTS=5
WEB_SEARCH_MAX_EXTRACT_RESULTS=3
WEB_SEARCH_MAX_EVIDENCE_CHARS=10000
WEB_SEARCH_MAX_SOURCE_CHARS=1200

# --- Redis / Celery (email delivery + auth rate limiting) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Result backend intentionally empty: task outcomes live in email_outbox.
CELERY_RESULT_BACKEND=

# --- Email / verification ---
# Public base URL of the frontend SPA; verification links point here.
FRONTEND_APP_URL=http://localhost:5173
# postmark | resend | console | fake. console prints to logs (local dev); fake
# collects in memory (tests). Postmark/Resend fields below are validated ONLY
# when the matching provider is selected.
EMAIL_PROVIDER=console
EMAIL_FROM=iChat <no-reply@mail.feslia.com>
EMAIL_REPLY_TO=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_BASE_URL=https://api.postmarkapp.com
POSTMARK_TIMEOUT_SECONDS=10
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_SECONDS=10

AUTH_EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
AUTH_EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_ACCOUNT_DELETION_TOKEN_TTL_SECONDS=1800

# Per-IP sliding-window rate limits (limit / window seconds).
AUTH_RATE_REGISTER_IP_LIMIT=5
AUTH_RATE_REGISTER_IP_WINDOW_SECONDS=3600
AUTH_RATE_RESEND_IP_LIMIT=10
AUTH_RATE_RESEND_IP_WINDOW_SECONDS=3600
AUTH_RATE_VERIFY_IP_LIMIT=30
AUTH_RATE_VERIFY_IP_WINDOW_SECONDS=60
AUTH_RATE_PASSWORD_RESET_REQUEST_IP_LIMIT=5
AUTH_RATE_PASSWORD_RESET_REQUEST_IP_WINDOW_SECONDS=3600
# change-password anti-brute-force (failed attempts per user + per-IP window).
AUTH_RATE_PASSWORD_CHANGE_USER_LIMIT=5
AUTH_RATE_PASSWORD_CHANGE_USER_WINDOW_SECONDS=900
AUTH_RATE_PASSWORD_CHANGE_IP_LIMIT=10
AUTH_RATE_PASSWORD_CHANGE_IP_WINDOW_SECONDS=3600
AUTH_RATE_DELETION_REQUEST_IP_LIMIT=5
AUTH_RATE_DELETION_REQUEST_IP_WINDOW_SECONDS=3600

EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_LEASE_SECONDS=120
EMAIL_OUTBOX_SWEEP_INTERVAL_SECONDS=60

# --- Avatar uploads / Cloudflare R2 ---
# Keep false until both buckets, credentials, public domain, and purge token exist.
AVATAR_STORAGE_ENABLED=false
AVATAR_R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AVATAR_R2_REGION=auto
AVATAR_UPLOAD_BUCKET=ichat-dev-avatar-uploads
AVATAR_PUBLIC_BUCKET=ichat-dev-avatars
AVATAR_API_ACCESS_KEY_ID=
AVATAR_API_SECRET_ACCESS_KEY=
AVATAR_WORKER_ACCESS_KEY_ID=
AVATAR_WORKER_SECRET_ACCESS_KEY=
AVATAR_PUBLIC_BASE_URL=https://assets-dev.example.com
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
AVATAR_PRESIGN_TTL_SECONDS=600
AVATAR_SESSION_TTL_SECONDS=1800
AVATAR_UPLOAD_MAX_BYTES=2097152
AVATAR_RATE_USER_LIMIT=10
AVATAR_RATE_IP_LIMIT=30
AVATAR_RATE_WINDOW_SECONDS=3600
AVATAR_PROCESSING_LEASE_SECONDS=300
AVATAR_PROCESSING_MAX_ATTEMPTS=3
AVATAR_MAINTENANCE_INTERVAL_SECONDS=3600
AVATAR_MAINTENANCE_BATCH_SIZE=100
AVATAR_HISTORY_RETENTION_SECONDS=604800
AVATAR_CLEANUP_SAFETY_SECONDS=300

# --- Unified private message attachments / Cloudflare R2 ---
# The three credentials are intentionally distinct: upload signing may only
# write/head staging, the file worker may process staging/canonical objects,
# and the download signer may only issue canonical GET requests.
FILE_UPLOAD_ENABLED=false
FILES_R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
FILES_R2_REGION=auto
FILES_STAGING_BUCKET=ichat-dev-file-staging
FILES_CANONICAL_BUCKET=ichat-dev-files
FILES_UPLOAD_ACCESS_KEY_ID=
FILES_UPLOAD_SECRET_ACCESS_KEY=
FILES_WORKER_ACCESS_KEY_ID=
FILES_WORKER_SECRET_ACCESS_KEY=
FILES_DOWNLOAD_ACCESS_KEY_ID=
FILES_DOWNLOAD_SECRET_ACCESS_KEY=
FILES_UPLOAD_PRESIGN_TTL_SECONDS=600
FILES_DOWNLOAD_TTL_SECONDS=300
FILES_UPLOAD_SESSION_TTL_SECONDS=1800
FILES_UNBOUND_TTL_SECONDS=86400
FILES_DETACHED_RETENTION_SECONDS=2592000
CONVERSATION_DELETION_RETENTION_SECONDS=2592000
FILES_QUOTA_BYTES=1073741824
FILES_MAX_INFLIGHT_UPLOADS=5
FILES_MAX_ATTACHMENTS_PER_MESSAGE=5
FILES_MAX_MESSAGE_BYTES=52428800
FILES_RATE_USER_LIMIT=100
FILES_RATE_IP_LIMIT=500
FILES_RATE_WINDOW_SECONDS=3600
FILES_PROCESSING_LEASE_SECONDS=300
FILES_PROCESSING_MAX_ATTEMPTS=3
FILES_PARSER_TIMEOUT_SECONDS=120
FILES_ATTEMPT_TIMEOUT_SECONDS=180
FILES_MAINTENANCE_INTERVAL_SECONDS=60
FILES_MAINTENANCE_BATCH_SIZE=100
FILES_CLEANUP_SAFETY_SECONDS=300
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_SIGNATURE_MAX_AGE_SECONDS=172800
